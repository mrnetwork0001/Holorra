# ==============================================================================
# HOLORRA — Manycore Aholo Global 3D AI Hackathon Configuration
# ==============================================================================

# 1. Manycore Aholo Open Platform API Key
# Global Portal: https://labs.aholo.ai/api-keys
# China Portal:  https://labs.aholo.cn/api-keys
# Note: Raw API key string (do NOT prefix with "Bearer ")
AHOLO_API_KEY=

# 2. Aholo Regional Gateway
# "com" -> https://api.aholo.ai (Global default)
# "cn"  -> https://api.aholo.cn (China region)
AHOLO_REGION=com

# 3. Optional Anthropic / OpenAI Key for Holorra Spatial Co-Director NL Planning
# (Falls back to deterministic Aholo MCP tool planner when unset)
ANTHROPIC_API_KEY=

# 4. Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
