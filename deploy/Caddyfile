# /etc/caddy/Caddyfile
# Replace holorra.example.com with your domain. Caddy fetches and renews the HTTPS certificate itself.
holorra.example.com, www.holorra.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000 {
		# drop-ins stream large GLB files through /api/aholo/asset
		flush_interval -1
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
	# splat files, GLBs and captures are immutable per deploy
	@static path /assets/* /landing/* /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
