# /etc/systemd/system/holorra.service
# Runs the production build on 127.0.0.1:3000; Caddy (see Caddyfile) serves it on your domain with HTTPS.
[Unit]
Description=Holorra (Next.js production server)
After=network.target

[Service]
Type=simple
User=holorra
WorkingDirectory=/opt/holorra
# AHOLO_API_KEY / AHOLO_REGION live here, never in the repository
EnvironmentFile=-/etc/holorra.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start -- -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
