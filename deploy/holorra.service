# /etc/systemd/system/holorra.service
# Next.js on 127.0.0.1:3720; Caddy (holorra.caddy) serves it on the domain with HTTPS.
[Unit]
Description=Holorra (Next.js)
After=network.target

[Service]
Type=simple
User=holorra
WorkingDirectory=/opt/holorra
# AHOLO_API_KEY / AHOLO_REGION live here, never in the repository
EnvironmentFile=-/etc/holorra.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/node /opt/holorra/node_modules/next/dist/bin/next start -p 3720 -H 127.0.0.1
Restart=always
RestartSec=3
# shared host: never let Holorra take memory from other apps
MemoryMax=1G
Nice=5

[Install]
WantedBy=multi-user.target
